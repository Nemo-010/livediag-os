#!/bin/sh
# labwc session startup.

serial=$(/usr/local/bin/livediag-token 2>/dev/null)
log=/dev/ttyS0
[ -w "$log" ] || log=/dev/ttyAMA0
[ -w "$log" ] || log=/dev/null

printf 'LIVEDIAG-AUTOSTART token=%s wayland=%s runtime=%s bus=%s\n' \
    "${serial:-empty}" "${WAYLAND_DISPLAY:-unset}" \
    "${XDG_RUNTIME_DIR:-unset}" "${DBUS_SESSION_BUS_ADDRESS:-unset}" >>"$log"

wallpaper=$(/usr/local/bin/livediag-wallpaper 2>/dev/null)
if [ -n "$wallpaper" ] && [ -r "$wallpaper" ]; then
    swaybg -i "$wallpaper" &
else
    swaybg -c "#191b28" &
fi

waybar >/dev/null 2>&1 &

case "$serial" in
*livediag.video*)
    # Recording mode: leave breadcrumbs on the serial port so a blank
    # recording is explainable, prove GTK can open a window, force one small
    # 16:9 mode and go straight to the quick suite.
    {
        echo "LIVEDIAG-DIAG drm:"
        ls -l /dev/dri 2>&1
        echo "LIVEDIAG-DIAG runtime:"
        ls -l "$XDG_RUNTIME_DIR" 2>&1
        command -v zenity >/dev/null 2>&1 &&
            echo "LIVEDIAG-DIAG zenity present" ||
            echo "LIVEDIAG-DIAG zenity missing"
        timeout 25 zenity --info --no-markup --title=livediag \
            --text="Display check" >/dev/null 2>&1
        echo "LIVEDIAG-DIAG zenity-info-rc=$?"
    } >>"$log" 2>&1

    i=0
    output=""
    while [ "$i" -lt 20 ]; do
        output=$(wlr-randr 2>/dev/null |
            awk 'NF && $0 !~ /^[[:space:]]/ { print $1; exit }')
        [ -n "$output" ] && break
        sleep 0.5
        i=$((i + 1))
    done
    if [ -n "$output" ]; then
        wlr-randr --output "$output" --mode 1024x576 >>"$log" 2>&1 || true
    fi
    sleep 1
    /usr/local/bin/livediag-welcome >>"$log" 2>&1 &
    ;;
*)
    sleep 1
    /usr/local/bin/livediag-welcome &
    ;;
esac
