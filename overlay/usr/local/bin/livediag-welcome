#!/bin/sh
# Friendly greeter.  It loops, so closing everything never leaves a blank
# desktop: the welcome comes back.

# Recording mode: go straight to the quick check so the CI video shows the
# tests running without anyone needing to click through the welcome.
case "$(/usr/local/bin/livediag-token 2>/dev/null)" in
*livediag.video*) exec livediag --quick ;;
esac

while :; do
    choice=$(zenity --list --no-markup \
        --title="Welcome" \
        --text="Hello, and welcome.

This little system checks how this computer works under Linux.  It runs entirely from this image, so your disks and your files are left alone.

A progress window will follow along while the checks run: it shows what has passed and what is still to come.  If something is missing - a Wi-Fi card whose driver never loads, a battery, a camera - the report says so plainly.

What would you like to do?" \
        --width=640 --height=460 \
        --column="Choose one" \
        "Start the health check" \
        "Open a terminal" \
        "Reboot" 2>/dev/null) || choice="Start the health check"

    case "$choice" in
    "Open a terminal")
        foot &
        ;;
    "Reboot")
        /sbin/reboot 2>/dev/null
        ;;
    *)
        livediag
        ;;
    esac
done
